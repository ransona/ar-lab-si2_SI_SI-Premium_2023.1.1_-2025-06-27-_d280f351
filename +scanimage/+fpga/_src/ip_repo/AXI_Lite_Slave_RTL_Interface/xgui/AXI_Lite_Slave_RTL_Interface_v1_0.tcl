# Definitional proc to organize widgets for parameters.
proc init_gui { IPINST } {
  ipgui::add_param $IPINST -name "Component_Name"
  #Adding Page
  set g [ipgui::add_page $IPINST -name "g"]
  set DATA_WIDTH [ipgui::add_param $IPINST -name "DATA_WIDTH" -parent ${g} -widget comboBox]
  set_property tooltip {AXI Data Width} ${DATA_WIDTH}
  set ADDR_WIDTH [ipgui::add_param $IPINST -name "ADDR_WIDTH" -parent ${g}]
  set_property tooltip {AXI Address Width} ${ADDR_WIDTH}


}

